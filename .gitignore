# Output assets the tool produces in the user's CWD.
# (Doesn't apply to examples/ or components/ which ship with the repo.)
/ascii-*.txt
/ascii-*.png
/screenshot-*.png
/wireframe-*.txt
/wireframe-*.png

# Node deps (installed via scripts/install.sh or `npm install`)
node/node_modules/
node_modules/

# npm pack output
*.tgz

# Local dev scratch — design experiments + lazyweb cache (never shipped)
experiments/
.lazyweb/

# Editor / OS
.DS_Store
*.swp
.vscode/
.idea/

# Test fixtures we don't ship
test-fixtures/*.png
test-fixtures/*.jpg
!test-fixtures/.gitkeep
